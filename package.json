{
  "name": "sitecleaner",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "A Chrome extension for designers: select, restyle, move, measure and check any element on any page, undo it all, and hand the changes over as Markdown.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs --zip",
    "share": "node scripts/build.mjs --share",
    "beta": "node scripts/beta.mjs",
    "verify:share": "node scripts/verify-share.mjs",
    "share:personal": "node scripts/build.mjs --edition consumer --zip --share",
    "release:build": "node scripts/build.mjs --zip --share && node scripts/build.mjs --edition consumer --zip --share",
    "test": "node test/e2e.mjs && node test/editions.mjs && node test/keep.mjs && node test/access.mjs && node test/stress.mjs && node scripts/a11y.mjs && node scripts/a11y.mjs --consumer",
    "test:browser": "node test/e2e.mjs && node test/editions.mjs && node test/keep.mjs && node test/access.mjs && node test/stress.mjs",
    "test:stress": "node test/stress.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "smoke": "node scripts/smoke-real-sites.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "promo": "node scripts/promo-tile.mjs",
    "profile": "node scripts/profile.mjs",
    "test:editions": "node test/editions.mjs",
    "build:consumer": "node scripts/build.mjs --edition consumer",
    "test:keep": "node test/keep.mjs",
    "test:access": "node test/access.mjs",
    "test:a11y:consumer": "node scripts/a11y.mjs --consumer"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright": "1.65.0"
  }
}
